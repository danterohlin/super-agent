TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Optional; default is a current Sonnet model slug
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Numeric Telegram user ID (only this user can use the bot)
ALLOWED_TELEGRAM_USER_ID=6525313647

GITHUB_TOKEN=

# Sentry REST API (default host is SaaS). For self-hosted, set SENTRY_API_BASE.
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
# Optional: when set, sentry_list_issues can default to this project
SENTRY_PROJECT_SLUG=
# SENTRY_API_BASE=https://sentry.io/api/0

DATABASE_PATH=./data/bot.sqlite

# Milliseconds between background ticks (Slack/email/Trello later)
BACKGROUND_POLL_MS=300000
